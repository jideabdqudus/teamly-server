# Server — Swagger UI: http://localhost:3001/api/docs (same PORT as below); OpenAPI JSON: /api/v1/openapi.json
PORT=3001
NODE_ENV=development
# Optional: fatal | error | warn | info | debug | trace | silent (default: info in prod, debug in dev)
# LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Dashboard → Project Settings → API → JWT Settings → "JWT Secret" (legacy HS256 signing key).
# Required by env validation; current code verifies tokens via supabase.auth.getUser(), not this secret.
SUPABASE_JWT_SECRET=your-jwt-secret

# Postgres connection for Prisma (Supabase: Project Settings → Database → Connection string → URI).
# Use port 5432 (direct or session pooler). Prisma migrate deploy needs a URL that can run DDL.
# Example: postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Redis (required for BullMQ)
REDIS_URL=redis://localhost:6379

# Internal API auth (required)
PULSEO_BACKEND_API_KEY=sk_live_your_secret_key_here

# LLM providers
OPENAI_API_KEY=sk-...          # Required (active provider)

# Future providers (uncomment when adding)
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=AIza...
# PERPLEXITY_API_KEY=pplx-...
# XAI_API_KEY=xai-...
# SERPAPI_API_KEY=...

# Email alerts (Phase 4)
# RESEND_API_KEY=re_...
